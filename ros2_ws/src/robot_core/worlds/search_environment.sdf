<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="search_environment">

    <!-- Gazebo Core Systems -->

    <plugin
        filename="gz-sim-physics-system"
        name="gz::sim::systems::Physics">
    </plugin>

    <plugin
        filename="gz-sim-user-commands-system"
        name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <plugin
        filename="gz-sim-sensors-system"
        name="gz::sim::systems::Sensors">
    </plugin>

    <plugin
        filename="gz-sim-imu-system"
        name="gz::sim::systems::Imu">
    </plugin>

    <!-- Physics -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Ground -->
    <model name="ground">

      <static>true</static>

      <link name="ground_link">

        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
        </visual>

      </link>

    </model>

    <!-- ========================= -->
    <!-- Search Building -->
    <!-- ========================= -->

    <model name="search_building">

      <static>true</static>

      <!-- Outer Wall: North -->
      <link name="north_wall">
        <pose>0 5 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>12 0.2 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>12 0.2 1</size>
            </box>
          </geometry>
          <material>
              <ambient>0.7 0.7 0.75 1</ambient>
              <diffuse>0.7 0.7 0.75 1</diffuse>
              <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>

      <!-- Outer Wall: South -->
      <link name="south_wall">
        <pose>0 -5 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>12 0.2 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>12 0.2 1</size>
            </box>
          </geometry>
          <material>
              <ambient>0.7 0.7 0.75 1</ambient>
              <diffuse>0.7 0.7 0.75 1</diffuse>
              <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>

      <!-- Outer Wall: East -->
      <link name="east_wall">
        <pose>6 0 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 10 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 10 1</size>
            </box>
          </geometry>
          <material>
              <ambient>0.7 0.7 0.75 1</ambient>
              <diffuse>0.7 0.7 0.75 1</diffuse>
              <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>

      <!-- Outer Wall: West -->
      <link name="west_wall">
        <pose>-6 0 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 10 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 10 1</size>
            </box>
          </geometry>
          <material>
              <ambient>0.7 0.7 0.75 1</ambient>
              <diffuse>0.7 0.7 0.75 1</diffuse>
              <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>

      <!-- Interior Wall 1 -->
      <link name="interior_wall_1">
        <pose>2 2.5 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 5 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 5 1</size>
            </box>
          </geometry>
          <material>
              <ambient>0.7 0.7 0.75 1</ambient>
              <diffuse>0.7 0.7 0.75 1</diffuse>
              <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>

      <!-- Interior Wall 2 -->
      <link name="interior_wall_2">
        <pose>-2 -2.5 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 5 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 5 1</size>
            </box>
          </geometry>
          <material>
              <ambient>0.7 0.7 0.75 1</ambient>
              <diffuse>0.7 0.7 0.75 1</diffuse>
              <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>

      <!-- Interior Wall 3 -->
      <link name="interior_wall_3">
        <pose>4 -1.5 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <box>
              <size>4 0.2 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>4 0.2 1</size>
            </box>
          </geometry>
          <material>
              <ambient>0.7 0.7 0.75 1</ambient>
              <diffuse>0.7 0.7 0.75 1</diffuse>
              <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>

    </model>

    <!-- Sun -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

  </world>

</sdf>
